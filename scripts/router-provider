#!/usr/bin/env python3
"""Local-only CLI and browser adapters. The native app owns credentials and HTTP inference."""
import base64
import hashlib
from http.server import BaseHTTPRequestHandler, HTTPServer
import json
import os
from pathlib import Path
import secrets
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from urllib.parse import parse_qs, urlencode, urlsplit


def browser_login(config):
    state, nonce, verifier = (secrets.token_urlsafe(48) for _ in range(3))
    result = {}

    class Handler(BaseHTTPRequestHandler):
        def setup(self):
            super().setup()
            self.connection.settimeout(4)

        def log_message(self, *args):
            pass

        def do_GET(self):
            url = urlsplit(self.path)
            query = parse_qs(url.query)
            if url.path != '/auth/callback' or query.get('state') != [state]:
                self.send_error(400)
                return
            result['code'] = query.get('code', [''])[0]
            result['client'] = query.get('client_id', [''])[0]
            result['denied'] = 'error' in query
            self.send_response(200)
            self.send_header('Content-Type', 'text/plain; charset=utf-8')
            self.send_header('Cache-Control', 'no-store')
            self.end_headers()
            self.wfile.write(b'Return to Tasktap to see your connection status.')

    with HTTPServer(('127.0.0.1', 0), Handler) as listener:
        redirect = 'http://127.0.0.1:%d/auth/callback' % listener.server_port
        params = dict(client_id=config.get('client') or 'dynamic_agent_client',
                      response_type='code', redirect_uri=redirect, state=state, nonce=nonce,
                      scope='openid profile email offline_access resource.invoke chatgpt.tokens.use.direct',
                      resource='https://api.openai.com/v1', ext_agent_host_id=config['host'],
                      code_challenge_method='S256', code_challenge=base64.urlsafe_b64encode(
                          hashlib.sha256(verifier.encode()).digest()).decode().rstrip('='))
        if not config.get('client'):
            params['agent_name_hint'] = 'Tasktap'
        elif config.get('email'):
            params['login_hint'] = config['email']
        # Only public request parameters enter the browser command.
        subprocess.run(['/usr/bin/open', 'https://auth.openai.com/api/accounts/authorize?' + urlencode(params)],
                       check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        listener.timeout = 1
        deadline = time.monotonic() + 180
        while not result and time.monotonic() < deadline:
            listener.handle_request()
    if result.get('denied') or not result.get('code'):
        raise ValueError('Sign-in was cancelled or expired. You can try again.')
    client = result['client'] or config.get('client')
    if not client or client == 'dynamic_agent_client' or (config.get('client') and client != config['client']):
        raise ValueError('The ChatGPT account registration could not be verified.')
    return dict(client=client, code=result['code'], verifier=verifier, nonce=nonce, redirect=redirect)


def cloud_provider(env):
    flags = {'CLAUDE_CODE_USE_BEDROCK': 'Amazon Bedrock', 'CLAUDE_CODE_USE_VERTEX': 'Google Cloud',
             'CLAUDE_CODE_USE_FOUNDRY': 'Microsoft Foundry'}
    names = [label for key, label in flags.items() if env.get(key, '').lower() in ('true', '1')]
    return names[0] if len(names) == 1 else ''


def cli_route(data):
    codex = data['route'] == 'codex'
    exe = shutil.which('codex' if codex else 'claude')
    if not exe:
        raise ValueError('Install the selected CLI, then reopen AI connections.')
    env = os.environ.copy()
    if not codex and not cloud_provider(env):
        raise ValueError('Configure one Claude Code cloud provider in the app environment.')
    with tempfile.TemporaryDirectory(prefix='tasktap-router-') as directory:
        schema = json.dumps(data['schema'])
        if codex:
            path = Path(directory) / 'handoff.json'
            path.write_text(schema)
            args = [exe, '--ask-for-approval', 'never', 'exec', '--ignore-user-config', '--ephemeral',
                    '--disable', 'shell_tool', '--disable', 'unified_exec', '--disable', 'plugins',
                    '--disable', 'hooks', '-c', 'project_doc_max_bytes=0', '-c', 'web_search="disabled"',
                    '--sandbox', 'read-only', '--skip-git-repo-check', '--output-schema', str(path),
                    '-o', str(Path(directory) / 'result.json')]
            if data['model']:
                args += ['--model', data['model']]
            args += ['-']
        else:
            args = [exe, '--bare', '-p', '--tools', '', '--strict-mcp-config', '--no-session-persistence',
                    '--output-format', 'json', '--json-schema', schema]
            if data['model']:
                args += ['--model', data['model']]
        proc = subprocess.Popen(args, cwd=directory, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, start_new_session=True)
        def stop(*_):
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
        signal.signal(signal.SIGTERM, lambda *_: (stop(), sys.exit(1)))
        try:
            out, _ = proc.communicate(data['prompt'].encode(), timeout=85)
            if proc.returncode:
                raise ValueError('The CLI could not finish. Check its login, model access and usage limits.')
            if codex:
                return json.loads((Path(directory) / 'result.json').read_text())
            response = json.loads(out)
            if response.get('is_error') or not isinstance(response.get('structured_output'), dict):
                raise ValueError('Claude Code returned no complete handoff.')
            return response['structured_output']
        finally:
            stop()


def codex_identity(_):
    sys.dont_write_bytecode = True
    from worker_usage import codex_identity as read_identity
    return {'label':read_identity()}


def worker_usage(data):
    sys.dont_write_bytecode = True
    from worker_usage import snapshot
    return snapshot(data.get('agents', []))


def worker_status():
    def probe(argv):
        try:
            return subprocess.run(argv, capture_output=True, text=True, timeout=4, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            return None
    installed = {name: bool(shutil.which(name)) for name in ('codex', 'claude', 'agy', 'cursor-agent', 'pi')}
    health = {name: 'unknown' if found else 'missing' for name, found in installed.items()}
    state = {name: 'Billing source unverified' if found else 'CLI missing' for name, found in installed.items()}
    if installed['codex']:
        run = probe(['codex', 'login', 'status'])
        if run:
            status = (run.stdout + run.stderr).lower()
            if run.returncode == 0:
                health['codex'] = 'signedIn'
                if 'chatgpt' in status: state['codex'] = 'ChatGPT login'
                elif 'api key' in status: state['codex'] = 'API key login'
            elif 'not logged in' in status:
                health['codex'], state['codex'] = 'signedOut', 'Sign-in needed'
    if installed['claude']:
        run = probe(['claude', 'auth', 'status', '--json'])
        try:
            info = json.loads(run.stdout) if run else {}
            if not isinstance(info, dict): info = {}
        except ValueError:
            info = {}
        cloud = cloud_provider(os.environ)
        if cloud: state['claude'] = cloud + ' configured'
        elif os.environ.get('ANTHROPIC_BASE_URL') or os.environ.get('ANTHROPIC_AUTH_TOKEN'):
            state['claude'] = 'Custom endpoint or token configured'
        elif os.environ.get('ANTHROPIC_API_KEY'): state['claude'] = 'API key configured'
        elif info.get('loggedIn') is False: state['claude'] = 'Sign-in needed'
        elif info.get('authMethod') in ('claude.ai', 'oauth') and info.get('subscriptionType'):
            state['claude'] = 'Claude plan login'
        elif info.get('authMethod') in ('api_key', 'apiKey', 'console'): state['claude'] = 'Console login'
        if state['claude'].endswith(' configured'): health['claude'] = 'configured'
        elif info.get('loggedIn') is False: health['claude'] = 'signedOut'
        elif info.get('loggedIn') is True: health['claude'] = 'signedIn'
    if installed['agy']:
        health['agy'] = 'installed'
        if os.environ.get('GEMINI_API_KEY'):
            health['agy'], state['agy'] = 'configured', 'Gemini API key configured'
    if installed['pi']:
        health['pi'] = 'installed'
    if installed['cursor-agent']:
        run = probe(['cursor-agent', 'status', '--format', 'json'])
        try:
            info = json.loads(run.stdout) if run else {}
        except ValueError:
            info = {}
        if isinstance(info, dict) and type(info.get('isAuthenticated')) is bool:
            health['cursor-agent'] = 'signedIn' if info['isAuthenticated'] else 'signedOut'
            state['cursor-agent'] = 'Cursor account' if info['isAuthenticated'] else 'Sign-in needed'
    return dict(workers=state, workerHealth=health, cloud=cloud_provider(os.environ))


def worker_login(data):
    agent = data.get('agent')
    args = {'claude':['auth','login'], 'codex':['login'], 'cursor-agent':['login']}.get(agent)
    if not args: raise ValueError('This agent manages sign-in in its own app.')
    exe = shutil.which(agent)
    if not exe: raise ValueError('Install the agent first, then check again.')
    script = '''on run argv
        tell application id "com.apple.Terminal"
            do script (item 1 of argv)
            activate
        end tell
    end run'''
    result = subprocess.run(['/usr/bin/osascript','-e',script,'exec '+shlex.join([exe,*args])],
                            stdin=subprocess.DEVNULL,capture_output=True,timeout=60)
    if result.returncode:
        raise ValueError('Couldn’t open Terminal. Check Tasktap’s Automation access in System Settings.')
    return {}


if __name__ == '__main__':
    try:
        command = sys.argv[1]
        data = json.load(sys.stdin)
        value = {'login': browser_login, 'route': cli_route, 'status': lambda _: worker_status(), 'usage': worker_usage, 'codex-identity': codex_identity, 'worker-login': worker_login}[command](data)
        print(json.dumps({'value': value}))
    except ValueError as exc:
        # Parser errors can contain snippets of provider data. Only expose our own messages.
        print(json.dumps({'error': str(exc) if type(exc) is ValueError else 'The provider returned an unreadable response.'}))
    except Exception:
        print(json.dumps({'error': 'The provider helper could not finish. Check its installation and try again.'}))
