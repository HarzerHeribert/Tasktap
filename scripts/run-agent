#!/usr/bin/env python3
"""Deliver reviewed jobs to Tasktap terminal sessions. The dispatcher itself never runs a worker."""
import fcntl
import json
import os
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
import visible_session as visible


def drain(folder):
    with (folder/'.lock').open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        for path in sorted(folder.glob('*.job')):
            receipt = path.with_suffix('.receipt')
            if receipt.exists():
                if visible.load(receipt)['state']=='Running':
                    visible.save(receipt,dict(state='Failed',message='Delivery was interrupted. Check the original session before sending again.'))
                continue
            job={}
            try:
                job=visible.load(path)
                if job.get('delivery')!='interactive':
                    raise ValueError('Saved from an earlier Tasktap version. Review this capture to start a visible session.')
                if job['mode']=='ask':
                    visible.save(receipt,dict(state='Opening',message='Opening the reviewed terminal session.'))
                    visible.open_window(path,job)
                    continue
                visible.save(receipt,dict(state='Running'))
                if job.get('manual'):
                    visible.endpoint(folder)
                    subprocess.run(['/usr/bin/pbcopy'],input=job['outgoing'].encode(),check=True)
                    try:
                        visible.focus(folder)
                        note='Paste at the agent prompt and press Return.'
                    except Exception:
                        note='Open the original session, paste at the agent prompt and press Return.'
                    if visible.load(receipt)['state']=='Running':
                        visible.save(receipt,dict(state='Copied',message='Copied to clipboard. '+note))
                    continue
                message=visible.nudge(folder,job)
                if visible.load(receipt)['state']=='Running':
                    visible.save(receipt,dict(state='Delivered',message=message))
            except Exception as exc:
                detail = (exc.stderr or '') if isinstance(exc,subprocess.CalledProcessError) else ''
                if isinstance(detail,bytes):detail=detail.decode(errors='replace')
                if job.get('mode')=='ask':
                    # A late reply can arrive after the terminal took ownership.
                    if visible.locked(folder) or (receipt.exists() and visible.load(receipt)['state']!='Opening'):
                        continue
                    if isinstance(exc,subprocess.SubprocessError):
                        detail='Tasktap could not open the session. Check that its terminal service is running.'
                visible.save(receipt,dict(state='Failed',message=(detail or '').strip()[:400] or str(exc)))


if __name__=='__main__':
    os.umask(0o077)
    if sys.argv[1]=='present':
        path=Path(sys.argv[2])
        flags=sys.argv[4:]
        ticket=flags[1] if flags[:1]==['--reopen'] and len(flags)>=2 else None
        try:
            code=visible.present(path,sys.argv[3],ticket)
            sys.exit(code if code>=0 else 128-code)
        except Exception as error:
            if not ticket and not visible.locked(path.parent) and (not (path.parent/'surface.json').exists() or visible.load(path.with_suffix('.receipt')).get('state')=='Opened'):
                visible.save(path.with_suffix('.receipt'),dict(state='Failed',message=str(error)))
            sys.exit(str(error))
    elif sys.argv[1]=='rows':
        from session_rows import rows
        print(json.dumps(rows(Path(sys.argv[2]))))
    elif sys.argv[1]=='reopen':
        try: visible.reopen(Path(sys.argv[2]))
        except Exception as error:
            detail=error.stderr if isinstance(error,subprocess.CalledProcessError) else ''
            if isinstance(detail,bytes):detail=detail.decode(errors='replace')
            sys.exit((detail or str(error) or 'Could not reopen this session.').strip()[:450])
    else:
        drain(Path(sys.argv[1]))
